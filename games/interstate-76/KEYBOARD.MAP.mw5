#*********************************************
#*
#*  Interstate '76 Keyboard Mapping File
#*  MW5-STYLE LAPTOP LAYOUT (proposal, 2026-07-04)
#*
#*  To use: BACK UP the original KEYBOARD.MAP in the game folder,
#*  then copy this file over it (renamed to KEYBOARD.MAP).
#*  NOT yet play-tested - verify in Instant Melee first.
#*
#*  W/S throttle(notched) A/D steer Space fire Tab cycle F link
#*  X reverse C handbrake I ignition Q front-target T nearest
#*  Y next U untarget R radar-range K radar-cam E glance-target
#*  Arrows glance H lights B binocs G horn M map N notepad P poetry
#*
#*********************************************
throttle_up          {
   + keyboard     W
   - keyboard     Shift
   - keyboard     Control
}
throttle_down        {
   + keyboard     S
   - keyboard     Shift
   - keyboard     Control
}
steer_left           {
   + keyboard     A
   - keyboard     Shift
   - keyboard     Control
}
steer_right          {
   + keyboard     D
   - keyboard     Shift
   - keyboard     Control
}
shift_up             {
   + keyboard     Period
   - keyboard     Shift
   - keyboard     Control
}
shift_down           {
   + keyboard     Comma
   - keyboard     Shift
   - keyboard     Control
}
reverse_direction    {
   + keyboard     X
   - keyboard     Shift
   - keyboard     Control
}
weapon_fire          {
   + keyboard     Space
   - keyboard     Shift
   - keyboard     Control
}
weapon_cycle         {
   + keyboard     Tab
   - keyboard     Shift
   - keyboard     Control
}
weapon_link          {
   + keyboard     F
   - keyboard     Shift
   - keyboard     Control
}
start_engine         {
   + keyboard     I
   - keyboard     Shift
   - keyboard     Control
}
show_map             {
   + keyboard     M
   - keyboard     Shift
   - keyboard     Control
}
show_notepad         {
   + keyboard     N
   - keyboard     Shift
   - keyboard     Control
}
toggle_binoculars    {
   + keyboard     B
   - keyboard     Shift
   - keyboard     Control
}
honk_horn            {
   + keyboard     G
   - keyboard     Shift
   - keyboard     Control
}
e_brake              {
   + keyboard     C
   - keyboard     Shift
   - keyboard     Control
}
toggle_lights        {
   + keyboard     H
   - keyboard     Shift
   - keyboard     Control
}
frontal_target       {
   + keyboard     Q
   - keyboard     Shift
   - keyboard     Control
}
radar_camera_toggle  {
   + keyboard     K
   - keyboard     Shift
   - keyboard     Control
}
next_target          {
   + keyboard     Y
   - keyboard     Shift
   - keyboard     Control
}
radar_range_toggle   {
   + keyboard     R
   - keyboard     Shift
   - keyboard     Control
}
target_nearest_enemy {
   + keyboard     T
   - keyboard     Shift
   - keyboard     Control
}
reset_target         {
   + keyboard     U
   - keyboard     Shift
   - keyboard     Control
}
poetry               {
   + keyboard     P
   - keyboard     Shift
   - keyboard     Control
}
pilot_glance_target  {
   + keyboard     E
   - keyboard     Shift
   - keyboard     Control
}
zoom_factor_reset    {
   + keyboard     GreyEnd
   - keyboard     Shift
   - keyboard     Control
}
toggle_cmbt_view     {
   + keyboard     V
   - keyboard     Shift
   - keyboard     Control
}
pilot_glance_up      {
   + keyboard     GreyUpArrow
}
pilot_glance_down    {
   + keyboard     GreyDownArrow
}
pilot_glance_left    {
   + keyboard     GreyLeftArrow
}
pilot_glance_right   {
   + keyboard     GreyRightArrow
}
track_pitch_plus     {
   + keyboard     UpArrow
}
track_pitch_minus    {
   + keyboard     DownArrow
}
track_yaw_minus      {
   + keyboard     LeftArrow
}
track_yaw_plus       {
   + keyboard     RightArrow
}
zoom_factor_plus     {
   + keyboard     GreyPageDown
}
track_distance_plus  {
   + keyboard     GreyPageDown
}
overview_zoom_plus   {
   + keyboard     GreyPageDown
}
zoom_factor_minus    {
   + keyboard     GreyPageUp
}
track_distance_minus {
   + keyboard     GreyPageUp
}
overview_zoom_minus  {
   + keyboard     GreyPageUp
}
