# This repo is docs + scripts ONLY. Never commit the game, prefixes, tokens, or logs.
*.app/
# Copy-protected game data (OpenRA-style: bring your own; see games/<slug>/game-data/README.md)
games/*/game-data/*
!games/*/game-data/README.md
logs/
steamcmd/
mw5-windows/
prefix/
*.log
.DS_Store
# Decoded/derived game art for local experiments (copyrighted; tools rebuild it)
games/*/texture-lab/*
!games/*/texture-lab/README.md
!games/*/texture-lab/*.py
__pycache__/
# Built helper binaries (source lives in games/*/tools/, e.g. i76wheel.c)
games/*/tools/*.exe
# Personal save-game backups (binary save data; never commit)
mw5-save-backups/

# local secrets (Steam Deck SSH etc.) - never publish
.env
**/.env
games/interstate-76/smack-music-fix/SMACKW32.DLL
# local backups made by the I76 tooling
games/interstate-76/*.pre-*
